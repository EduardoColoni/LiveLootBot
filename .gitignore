.venv/

# Ignorar arquivos temporários do Python
__pycache__/
*.py[cod]

# Ignorar variáveis de ambiente
.env

# Ignorar arquivos de log
*.log

# Ignorar configurações de IDEs (como PyCharm)
.idea/

# Dumps do banco (contêm hashes de senha)
*.sql.bak
schema_all.sql
