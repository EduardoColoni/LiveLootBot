# Copie para .env nesta mesma pasta e preencha. O .env está no .gitignore.
#
# O docker compose lê estas variáveis do .env que fica ao lado do
# docker-compose.yml — não do .env da aplicação, que está em src/.

# Precisam ser iguais a DB_USER, DB_PASSWORD e DB_NAME do src/.env
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=troque_aqui
POSTGRES_DB=live_loot_bot_test

# Token do agente ngrok (dashboard.ngrok.com)
NGROK_TOKEN=troque_aqui
