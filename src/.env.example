############################ COMO USAR ###############################################
# Copie este arquivo para .env NESTA MESMA PASTA (src/.env) e preencha os valores.
# O .env está no .gitignore e nunca deve ser enviado para o repositório.
#
#     cp src/.env.example src/.env
#
# O passo a passo de onde obter cada valor está no README.md, seção "Instalação".
#
# Atenção: existe um SEGUNDO arquivo de configuração, o PostDocker/.env, usado pelo
# Docker Compose. As credenciais do banco precisam ser iguais nos dois.
######################################################################################


############################DISCORD###################################################
# Developer Portal > sua aplicação > Bot > Reset Token
# Lembre de ativar o MESSAGE CONTENT INTENT na mesma tela, senão o !autenticar
# para de funcionar sem dar erro.
DISCORD_TOKEN=


############################TWITCH####################################################
# dev.twitch.tv/console/apps > sua aplicação
CLIENT_ID=
CLIENT_SECRET=

# ID numérico da conta da Twitch que o bot usa para falar no chat.
# É uma conta SEPARADA da conta do canal. Sem isto, o sistema recusa a
# autenticação do bot dizendo que a conta é a errada.
BOT_PLATFORM_ID=

# Precisam estar cadastrados em OAuth Redirect URLs, no app da Twitch,
# idênticos caractere a caractere e sem barra no final.
REDIRECT_URI_STREAMER=https://SEU-DOMINIO.ngrok-free.app/twitch_callback/streamer
REDIRECT_URI_VIEWER=https://SEU-DOMINIO.ngrok-free.app/twitch_callback/viewer

# Opcional: se não for definida, é derivada de URL_BASE.
# REDIRECT_URI_BOT=https://SEU-DOMINIO.ngrok-free.app/twitch_callback/bot

TWITCH_URL=https://id.twitch.tv/oauth2

# Segredo que a Twitch usa para assinar (HMAC-SHA256) as mensagens do chat que
# chegam no webhook. De 10 a 100 caracteres. Gere um valor aleatório com:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Se trocar este valor, rode de novo a criação da inscrição de eventos
# (/twitch_callback/event_sub_signature): ela recria a inscrição com o novo.
TWITCH_WEBHOOK_SECRET=


############################CRIPTOGRAFIA##############################################
# Chave que cifra os tokens da Twitch antes de irem para o banco (Fernet).
# Gere com:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde uma cópia em lugar seguro: se ela for perdida ou trocada, os tokens
# gravados não podem mais ser lidos e é preciso refazer as autenticações.
TOKEN_ENCRYPTION_KEY=


############################REDIS#####################################################
# Padrões do contêiner do docker-compose
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0


############################POSTGRES##################################################
# DB_USER, DB_PASSWORD e DB_NAME precisam ser IGUAIS a POSTGRES_USER,
# POSTGRES_PASSWORD e POSTGRES_DB do PostDocker/.env — é o mesmo banco.
DB_HOST=localhost
DB_PORT=5432
DB_USER=dev_user
DB_PASSWORD=
DB_NAME=live_loot_bot_test


############################API#######################################################
# URL pública da API, pela qual a Twitch alcança os callbacks de OAuth e entrega
# os eventos de chat. Em desenvolvimento, o domínio estático do ngrok.
URL_BASE=https://SEU-DOMINIO.ngrok-free.app
